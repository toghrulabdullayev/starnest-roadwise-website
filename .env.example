# Local dev uses a SQLite file; production uses Turso (libsql://<db>.turso.io)
DATABASE_URL=file:./data/roadwise.db
DATABASE_AUTH_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOWNLOAD_URL=
NEXT_PUBLIC_GAME_VERSION=

# Optional: USD per 1M tokens from the Gemini pricing page, used by npm run eval for cost per debrief
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
