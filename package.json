{
  "name": "starnestai-roadwise-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env.local scripts/reset-db.ts && npm run db:migrate",
    "contract:export": "node scripts/export-contract.ts",
    "fixtures:make": "node scripts/make-fixtures.ts",
    "debrief:demo": "node --env-file-if-exists=.env.local scripts/debrief-demo.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@libsql/client": "^0.18.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
