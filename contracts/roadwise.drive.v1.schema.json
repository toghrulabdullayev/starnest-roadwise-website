{
  "$id": "https://roadwise.app/contracts/roadwise.drive.v1.schema.json",
  "title": "roadwise.drive.v1",
  "description": "Roadwise drive telemetry v1. Generated from lib/telemetry/schema.ts. Extra server-side checks not expressible here: samples.fields must contain each field exactly once and every row must have fields.length values; event ids unique per drive; rule_check with outcome=fail requires severity and fine_azn; drive.exam required in exam mode and null in free mode.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "roadwise.drive.v1"
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "drive": {
      "type": "object",
      "properties": {
        "client_drive_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "free",
            "exam"
          ]
        },
        "district": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "route_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "car_type": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "time_of_day": {
          "type": "string",
          "enum": [
            "day",
            "dusk",
            "night"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "exam": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "minor_faults": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "major_faults": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "checkpoints_reached": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "checkpoints_total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "passed",
                "minor_faults",
                "major_faults",
                "checkpoints_reached",
                "checkpoints_total"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "client_drive_id",
        "mode",
        "time_of_day",
        "started_at",
        "duration_s",
        "distance_m",
        "exam"
      ]
    },
    "samples": {
      "type": "object",
      "properties": {
        "hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "fields": {
          "minItems": 9,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "t",
              "x",
              "z",
              "speed_kmh",
              "limit_kmh",
              "throttle",
              "brake",
              "steer",
              "handbrake"
            ]
          }
        },
        "rows": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "hz",
        "fields",
        "rows"
      ]
    },
    "events": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "t": {
                "type": "number",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "rule_check"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "speeding",
                  "red_light",
                  "stop_sign",
                  "pedestrian_crossing",
                  "wrong_way",
                  "give_way",
                  "collision"
                ]
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "major",
                  "minor"
                ]
              },
              "fine_azn": {
                "type": "number",
                "minimum": 0
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "street": {
                "type": "string",
                "maxLength": 200
              },
              "detail": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "id",
              "t",
              "type",
              "rule",
              "outcome",
              "x",
              "z"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "t": {
                "type": "number",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "checkpoint"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "t",
              "type",
              "index"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "client",
    "drive",
    "samples",
    "events"
  ]
}
